{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "volteer_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "chronicler",
            "product": "volteer"
          },
          "hardware-features": {
            "build-path": "chronicler/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_chronicler.xml",
            "system-path": "/etc/hardware_features_chronicler.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "chronicler",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.chronicler/HiFi.conf",
                "source": "chronicler/audio/ucm-config/sof-rt5682.chronicler/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.chronicler/sof-rt5682.chronicler.conf",
                "source": "chronicler/audio/ucm-config/sof-rt5682.chronicler/sof-rt5682.chronicler.conf"
              },
              {
                "destination": "/etc/cras/chronicler/sof-rt5682",
                "source": "chronicler/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/chronicler/dsp.ini",
                "source": "chronicler/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-volteer.conf",
                "source": "alsa-module-config/alsa-volteer.conf"
              },
              {
                "destination": "/etc/cras/chronicler/board.ini",
                "source": "chronicler/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "chronicler"
          }
        },
        "camera": {
          "count": 0
        },
        "identity": {
          "platform-name": "Volteer",
          "sku-id": 2147483647,
          "smbios-name-match": "Chronicler"
        },
        "name": "chronicler",
        "power": {
          "battery-poll-interval-initial-ms": "1000",
          "disable-dark-resume": "0",
          "has-ambient-light-sensor": "0",
          "has-keyboard-backlight": "0",
          "internal-backlight-als-steps": "63.34 47.62 -1 400\n100.0 93.9 100 -1",
          "internal-backlight-no-als-battery-brightness": "55.0",
          "low-battery-shutdown-percent": "4.0",
          "suspend-to-idle": "1"
        },
        "thermal": {
          "dptf-dv": "chronicler/dptf.dv",
          "files": [
            {
              "destination": "/etc/dptf/chronicler/dptf.dv",
              "source": "chronicler/sw_build_config/platform/chromeos-config/thermal/dptf.dv"
            }
          ]
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'volteer_cheets', 'firstApiLevel': '28'}",
