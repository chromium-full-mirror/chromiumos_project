{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "gimble",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "gimble/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_gimble.xml",
            "system-path": "/etc/hardware_features_gimble.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "gimble",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.gimble/HiFi.conf",
                "source": "gimble/audio/ucm-config/sof-rt5682.gimble/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.gimble/sof-rt5682.gimble.conf",
                "source": "gimble/audio/ucm-config/sof-rt5682.gimble/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/gimble/sof-rt5682",
                "source": "gimble/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/gimble/dsp.ini",
                "source": "gimble/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              },
              {
                "destination": "/etc/cras/gimble/board.ini",
                "source": "gimble/audio/cras-config/board.ini"
              },
              {
                "destination": "/etc/sound_card_init/gimble.yaml",
                "source": "gimble/audio/sound-card-init-config/sofrt5682.yaml"
              }
            ],
            "sound-card-init-conf": "gimble.yaml",
            "speaker-amp": "AMPLIFIER_UNKNOWN",
            "ucm-suffix": "gimble"
          }
        },
        "camera": {
          "count": 0
        },
        "identity": {
          "platform-name": "Brya",
          "sku-id": 65537,
          "smbios-name-match": "Gimble"
        },
        "name": "gimble",
        "power": {
          "battery-poll-interval-initial-ms": "1000",
          "defer-external-display-timeout": "10",
          "disable-dark-resume": "0",
          "has-ambient-light-sensor": "0",
          "has-keyboard-backlight": "1",
          "internal-backlight-als-steps": "63.34 47.62 -1 400\n100.0 93.9 100 -1",
          "internal-backlight-no-als-battery-brightness": "59",
          "low-battery-shutdown-percent": "4.0",
          "set-wifi-transmit-power-for-proximity": "0",
          "set-wifi-transmit-power-for-tablet-mode": "1",
          "suspend-to-idle": "1"
        },
        "thermal": {
          "dptf-dv": "gimble/dptf.dv",
          "files": [
            {
              "destination": "/etc/dptf/gimble/dptf.dv",
              "source": "gimble/sw_build_config/platform/chromeos-config/thermal/dptf.dv"
            }
          ]
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'brya_cheets', 'firstApiLevel': '28'}",
            "--child-wallpaper-large=/usr/share/chromeos-assets/wallpaper/child_large.jpg",
