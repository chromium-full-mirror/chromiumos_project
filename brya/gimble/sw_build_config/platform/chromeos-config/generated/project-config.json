{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "gimble",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "gimble/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_gimble.xml",
            "system-path": "/etc/hardware_features_gimble.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "gimble",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.brya/HiFi.conf",
                "source": "brya/audio/ucm-config/sof-rt5682.brya/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.brya/sof-rt5682.brya.conf",
                "source": "brya/audio/ucm-config/sof-rt5682.brya/sof-rt5682.conf"
              },
              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              }
            ],
            "ucm-suffix": "brya"
          }
        },
        "camera": {
          "count": 0
        },
        "identity": {
          "platform-name": "Brya",
          "sku-id": 65537,
          "smbios-name-match": "Gimble"
        },
        "name": "gimble",
        "power": {
          "battery-poll-interval-initial-ms": "1000",
          "defer-external-display-timeout": "10",
          "has-ambient-light-sensor": "0",
          "has-keyboard-backlight": "1",
          "internal-backlight-als-steps": "63.34 47.62 -1 400\n100.0 93.9 100 -1",
          "low-battery-shutdown-percent": "4.0",
          "set-wifi-transmit-power-for-proximity": "0",
          "set-wifi-transmit-power-for-tablet-mode": "1",
          "suspend-to-idle": "1"
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'brya_cheets', 'firstApiLevel': '28'}",
            "--child-wallpaper-large=/usr/share/chromeos-assets/wallpaper/child_large.jpg",
            "--child-wallpaper-small=/usr/share/chromeos-assets/wallpaper/child_small.jpg",
            "--default-wallpaper-large=/usr/share/chromeos-assets/wallpaper/default_large.jpg",
            "--default-wallpaper-small=/usr/share/chromeos-assets/wallpaper/default_small.jpg",
            "--guest-wallpaper-large=/usr/share/chromeos-assets/wallpaper/guest_large.jpg",
            "--guest-wallpaper-small=/usr/share/chromeos-assets/wallpaper/guest_small.jpg"
          ]
        }
      },
