      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "marketing-name": "",
            "metrics-tag": "marasov",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "marasov/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_marasov.xml",
            "system-path": "/etc/hardware_features_marasov.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "marasov",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.marasov/HiFi.conf",
                "source": "marasov/audio/ucm-config/sof-rt5682.marasov/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.marasov/sof-rt5682.marasov.conf",
                "source": "marasov/audio/ucm-config/sof-rt5682.marasov/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/marasov/sof-rt5682",
                "source": "marasov/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/marasov/dsp.ini",
                "source": "marasov/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              },
              {
                "destination": "/etc/cras/marasov/board.ini",
                "source": "marasov/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "marasov"
          }
        },
        "camera": {
          "count": 0
        },
        "firmware": {
          "bcs-overlay": "overlay-brya-private",
          "build-targets": {
            "ec": "marasov"
          },
          "firmware-config": 0
        },
        "hardware-properties": {
          "storage-type": "STORAGE_TYPE_UNKNOWN"
        },
