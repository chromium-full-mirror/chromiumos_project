{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "marketing-name": "",
            "metrics-tag": "skolas",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "skolas/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_skolas.xml",
            "system-path": "/etc/hardware_features_skolas.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "skolas",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.brya/HiFi.conf",
                "source": "brya/audio/ucm-config/sof-rt5682.brya/HiFi.conf"
