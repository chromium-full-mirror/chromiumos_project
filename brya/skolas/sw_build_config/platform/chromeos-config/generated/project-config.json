              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              },
              {
                "destination": "/etc/cras/skolas/board.ini",
                "source": "brya/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "brya"
          }
        },
        "bluetooth": {
          "flags": {
            "enable-bluetooth-offload": true
          }
        },
        "camera": {
          "count": 0
        },
        "firmware": {
          "bcs-overlay": "overlay-brya-private",
          "build-targets": {
            "ec": "brya"
          },
