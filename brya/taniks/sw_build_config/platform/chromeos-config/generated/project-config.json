{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "taniks",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "taniks/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_taniks.xml",
            "system-path": "/etc/hardware_features_taniks.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "taniks",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.taniks/HiFi.conf",
                "source": "taniks/audio/ucm-config/sof-rt5682.taniks/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.taniks/sof-rt5682.taniks.conf",
                "source": "taniks/audio/ucm-config/sof-rt5682.taniks/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/taniks/sof-rt5682",
                "source": "taniks/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/taniks/dsp.ini",
                "source": "taniks/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              },
              {
                "destination": "/etc/cras/taniks/board.ini",
                "source": "taniks/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "taniks"
          }
        },
        "camera": {
          "count": 0
        },
        "identity": {
          "platform-name": "Brya",
          "sku-id": 589824,
          "smbios-name-match": "Taniks"
        },
        "name": "taniks",
        "power": {
          "disable-dark-resume": "0",
          "has-keyboard-backlight": "1",
          "low-battery-shutdown-percent": "4.0",
          "suspend-to-idle": "1"
        },
        "thermal": {
          "dptf-dv": "taniks/taniks/dptf.dv",
          "files": [
            {
              "destination": "/etc/dptf/taniks/taniks/dptf.dv",
              "source": "taniks/sw_build_config/platform/chromeos-config/thermal/taniks/dptf.dv"
            }
          ]
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'brya_cheets', 'firstApiLevel': '28'}",
