{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "brya_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "mithrax",
            "product": "brya"
          },
          "hardware-features": {
            "build-path": "mithrax/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_mithrax.xml",
            "system-path": "/etc/hardware_features_mithrax.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "mithrax",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.mithrax.rt5682vs/HiFi.conf",
                "source": "mithrax/audio/ucm-config/sof-rt5682.mithrax.rt5682vs/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.mithrax.rt5682vs/sof-rt5682.mithrax.rt5682vs.conf",
                "source": "mithrax/audio/ucm-config/sof-rt5682.mithrax.rt5682vs/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/mithrax/sof-rt5682",
                "source": "mithrax/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/mithrax/dsp.ini",
                "source": "mithrax/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-brya.conf",
                "source": "alsa-module-config/alsa-brya.conf"
              },
              {
                "destination": "/etc/cras/mithrax/board.ini",
                "source": "mithrax/audio/cras-config/board.ini"
              }
            ],
            "ucm-suffix": "mithrax.rt5682vs"
          }
        },
        "camera": {
          "count": 0
        },
        "firmware": {
          "bcs-overlay": "overlay-brya-private",
          "build-targets": {
            "ec": "mithrax"
          },
          "firmware-config": 0
        },
        "identity": {
          "platform-name": "Brya",
          "sku-id": 2147483647,
          "smbios-name-match": "Mithrax"
        },
        "name": "mithrax",
        "power": {
          "defer-external-display-timeout": "10",
          "disable-dark-resume": "0",
          "has-keyboard-backlight": "1",
          "internal-backlight-no-als-battery-brightness": "50.5 300\n42.5 400\n37.0 500\n",
          "low-battery-shutdown-percent": "4.0",
          "min-visible-backlight-level": "5760",
          "set-wifi-transmit-power-for-tablet-mode": "1",
          "suspend-to-idle": "1"
        },
        "thermal": {
          "dptf-dv": "mithrax/dptf.dv",
          "files": [
            {
              "destination": "/etc/dptf/mithrax/dptf.dv",
              "source": "mithrax/sw_build_config/platform/chromeos-config/thermal/dptf.dv"
            }
          ]
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'brya_cheets', 'firstApiLevel': '28'}",
