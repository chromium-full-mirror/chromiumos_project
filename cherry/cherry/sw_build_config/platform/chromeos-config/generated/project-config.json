{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "cherry_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "cherry",
            "product": "cherry"
          },
          "hardware-features": {
            "build-path": "cherry/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_cherry.xml",
            "system-path": "/etc/hardware_features_cherry.xml"
          }
        },
        "camera": {
          "count": 0
        },
        "firmware": {
          "bcs-overlay": "overlay-cherry-private",
          "build-targets": {
            "coreboot": "cherry",
            "depthcharge": "cherry",
            "ec": "cherry",
            "libpayload": "cherry"
          },
          "firmware-config": 0
        },
        "identity": {
          "platform-name": "Cherry",
          "sku-id": 0
        },
        "name": "cherry",
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'cherry_cheets', 'firstApiLevel': '28'}",
            "--child-wallpaper-large=/usr/share/chromeos-assets/wallpaper/child_large.jpg",
            "--child-wallpaper-small=/usr/share/chromeos-assets/wallpaper/child_small.jpg",
            "--default-wallpaper-large=/usr/share/chromeos-assets/wallpaper/default_large.jpg",
            "--default-wallpaper-small=/usr/share/chromeos-assets/wallpaper/default_small.jpg",
            "--guest-wallpaper-large=/usr/share/chromeos-assets/wallpaper/guest_large.jpg",
            "--guest-wallpaper-small=/usr/share/chromeos-assets/wallpaper/guest_small.jpg"
          ]
        }
      }
    ]
  }
}
