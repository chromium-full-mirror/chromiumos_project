{
  "chromeos": {
    "configs": [
      {
        "arc": {
          "build-properties": {
            "device": "hades_cheets",
            "first-api-level": "28",
            "marketing-name": "",
            "metrics-tag": "cora",
            "product": "hades"
          },
          "hardware-features": {
            "build-path": "cora/public_sw_build_config/platform/chromeos-config/generated/arc/hardware_features_cora.xml",
            "system-path": "/etc/hardware_features_cora.xml"
          }
        },
        "audio": {
          "main": {
            "cras-config-dir": "cora",
            "files": [
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.cora/HiFi.conf",
                "source": "cora/audio/ucm-config/sof-rt5682.cora/HiFi.conf"
              },
              {
                "destination": "/usr/share/alsa/ucm/sof-rt5682.cora/sof-rt5682.cora.conf",
                "source": "cora/audio/ucm-config/sof-rt5682.cora/sof-rt5682.conf"
              },
              {
                "destination": "/etc/cras/cora/sof-rt5682",
                "source": "cora/audio/cras-config/card_settings"
              },
              {
                "destination": "/etc/cras/cora/dsp.ini",
                "source": "cora/audio/cras-config/dsp.ini"
              },
              {
                "destination": "/etc/modprobe.d/alsa-hades.conf",
                "source": "alsa-module-config/alsa-hades.conf"
              },
              {
                "destination": "/etc/cras/cora/board.ini",
                "source": "cora/audio/cras-config/board.ini"
              },
              {
                "destination": "/etc/sound_card_init/cora.yaml",
                "source": "cora/audio/sound-card-init-config/sofrt5682.yaml"
              }
            ],
            "sound-card-init-conf": "cora.yaml",
            "speaker-amp": "AMPLIFIER_UNKNOWN",
            "ucm-suffix": "cora"
          }
        },
        "bluetooth": {
          "flags": {
            "enable-bluetooth-offload": true
          }
        },
        "camera": {
          "count": 0
        },
        "identity": {
          "platform-name": "Hades",
          "sku-id": 2147483647,
          "smbios-name-match": "Cora"
        },
        "name": "cora",
        "power": {
          "defer-external-display-timeout": "10",
          "disable-dark-resume": "0",
          "has-keyboard-backlight": "1",
          "low-battery-shutdown-percent": "4.0",
          "suspend-to-idle": "1"
        },
        "thermal": {
          "dptf-dv": "cora/cora/dptf.dv",
          "files": [
            {
              "destination": "/etc/dptf/cora/cora/dptf.dv",
              "source": "cora/sw_build_config/platform/chromeos-config/thermal/cora/dptf.dv"
            }
          ]
        },
        "ui": {
          "extra-ash-flags": [
            "--arc-build-properties={'device': 'hades_cheets', 'firstApiLevel': '28'}",
            "--child-wallpaper-large=/usr/share/chromeos-assets/wallpaper/child_large.jpg",
            "--child-wallpaper-small=/usr/share/chromeos-assets/wallpaper/child_small.jpg",
            "--default-wallpaper-large=/usr/share/chromeos-assets/wallpaper/default_large.jpg",
            "--default-wallpaper-small=/usr/share/chromeos-assets/wallpaper/default_small.jpg",
            "--guest-wallpaper-large=/usr/share/chromeos-assets/wallpaper/guest_large.jpg",
            "--guest-wallpaper-small=/usr/share/chromeos-assets/wallpaper/guest_small.jpg"
          ]
        }
      }
    ]
  }
}
